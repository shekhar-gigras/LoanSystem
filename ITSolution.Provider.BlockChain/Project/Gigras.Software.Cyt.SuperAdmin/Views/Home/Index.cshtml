@using Gigras.Software.General.Model
@inject Gigras.Software.Cyt.Services.ICytServices.ICytAdminService cytAdmin

@model LoanCountInfo
@{
    ViewData["Title"] = "Home Page";
    var usettype = User.IsInRole("Admin") ? "admin" : "lender";
}
<style>

</style>
@if (User.IsInRole("Admin"))
{
    <div id="meta-container">
        <h1>Login with MetaMask</h1>
        <button id="loginMetaMaskButton">Login For Lender In MetaMask</button>
        <p id="metamaskstatus" class="status-disconnected">Please connect to MetaMask to log in.</p>
    </div>
}
<br />
<div id="kt_content_container" class="container-xxl dashboard-@usettype">
    <div class="row g-6 g-xl-9">
        <!-- Card 1 -->
        @if (User.IsInRole("Admin"))
        {
            @await Html.PartialAsync("~/Views/Partial/Dashboard/Change-Lender.cshtml")
            @await Html.PartialAsync("~/Views/Partial/Dashboard/SmartContract-Fund.cshtml")
            @await Html.PartialAsync("~/Views/Partial/Dashboard/Add-Fund.cshtml")
            @await Html.PartialAsync("~/Views/Partial/Dashboard/TakeOut-Fund.cshtml")
            @await Html.PartialAsync("~/Views/Partial/Dashboard/Lender-Balance.cshtml")
            @await Html.PartialAsync("~/Views/Partial/Dashboard/Active-Borrower.cshtml")
            @* @await Html.PartialAsync("~/Views/Partial/Dashboard/Request-Borrower.cshtml") *@
        }
        @if (User.IsInRole("Admin") || User.IsInRole("Lender"))
        {
            @await Html.PartialAsync("~/Views/Partial/UserDashboard/Requested-Borrower.cshtml",Model)
            @await Html.PartialAsync("~/Views/Partial/UserDashboard/Approved-Borrower.cshtml", Model)
            @await Html.PartialAsync("~/Views/Partial/UserDashboard/Rejected-Borrower.cshtml", Model)
            @await Html.PartialAsync("~/Views/Partial/UserDashboard/Deleted-Borrower.cshtml", Model)
            @await Html.PartialAsync("~/Views/Partial/UserDashboard/Requested-BorrowerAmount.cshtml", Model)
            @await Html.PartialAsync("~/Views/Partial/UserDashboard/Approved-BorrowerAmount.cshtml", Model)
            @await Html.PartialAsync("~/Views/Partial/UserDashboard/Rejected-BorrowerAmount.cshtml", Model)
            @await Html.PartialAsync("~/Views/Partial/UserDashboard/Deleted-BorrowerAmount.cshtml", Model)
        }

        @await Html.PartialAsync("~/Views/Partial/UserDashboard/SellLoan.cshtml", Model)
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const cards = document.querySelectorAll(".custom-card");

        // Predefined colors
        const colors = [
            "#FF5733", // Red-Orange
            "#33FF57", // Green
            "#3357FF", // Blue
            "#F7DC6F", // Yellow
            "#9B59B6", // Purple
            "#5DADE2", // Light Blue
            "#E74C3C", // Red
        ];

        // Apply fixed colors to cards
        cards.forEach((card, index) => {
            const color = colors[index % colors.length]; // Cycle through colors
            card.style.backgroundColor = color;
        });
    });

</script>
@if (User.IsInRole("Admin"))
{
    <script src="~/js/contract/dashboard/lender-info.js"></script>
    <script src="~/js/contract/dashboard/smart-contract.js"></script>
    <script src="~/js/contract/dashboard/change-lender.js"></script>
    <script src="~/js/contract/dashboard/add-fund.js"></script>
    <script src="~/js/contract/dashboard/takeout-fund.js"></script>
    <script src="~/js/contract/dashboard/lender-balance.js"></script>
    <script src="~/js/contract/dashboard/active-borrower.js"></script>
    <script src="~/js/contract/dashboard/requestd-borrower.js"></script>
    <script src="~/js/admin-website/dashboard.js"></script>
}
<script src="~/js/admin-website/module/loan-sell.js"></script>

